MANAGEBAC_USERNAME=your_email_or_username
MANAGEBAC_PASSWORD=your_password
MANAGEBAC_BASE_URL=https://kaism.managebac.com/student

HEADLESS=true
NAVIGATION_TIMEOUT_MS=30000
ACTION_TIMEOUT_MS=15000

RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=2

TASKS_OUTPUT_PATH=data/tasks_raw.json
AUTH_STATE_PATH=data/auth_state.json

# LLM providers. Both free tiers; no billing account needed for either.
# Groq: ~30 req/min, fast, small context. Default for tutor-mode outlining.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini: ~15 req/min, ~500/day, large context. Used for big-context prompts.
# Optional - with no key set, everything routes to Groq.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# auto = route by prompt size; or pin one backend with "groq" / "gemini".
LLM_PROVIDER=auto
# Prompts at or above this many characters route to the large-context backend.
LLM_LARGE_CONTEXT_CHARS=12000

VAULT_DB_PATH=vault.db
