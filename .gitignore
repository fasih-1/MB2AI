*.py[cod]
.venv/
venv/
*.pyc
.env
dist/
# PyInstaller's intermediate build cache for brain.exe - regenerated by
# `pyinstaller brain.spec` and was never meant to be version-controlled.
build/

# Secrets
.env

# Generated data and logs
data/auth_state.json
data/tasks_raw.json

# Scraped coursework and generated drafts. These are the user's own school
# files - assignment briefs, attachments, and AI-assisted drafts - and this
# repo has a public remote. They are local working data, never source.
data/attachments/
data/pending_review/

# Debug artifacts from a past scrape failure. Kept locally as the only saved
# ManageBac markup reference, but they contain the user's name and a screenshot
# of their dashboard, so they stay out of the repo.
data/debug_page.html
data/debug_zero_tasks.png
logs/
artifacts/

# Flutter / Dart
ui/build/
ui/.dart_tool/
ui/.flutter-plugins
ui/.flutter-plugins-dependencies
ui/.pub-cache/
ui/.pub/

# IDE
.vscode/

vault.db
# Pre-migration snapshots written by vault.py before a schema upgrade.
vault.db.bak-*
*.lnk
